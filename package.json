{
  "name": "remote-mcp",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Secure, owner-controlled local MCP agent for macOS",
  "bin": {
    "remote-mcp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs ci/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.js start",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.1.0",
    "ws": "^8.18.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
